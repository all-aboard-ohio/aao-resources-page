            "id": "2o43r7",
            "nodes": [
              {
                "type": "TEXT",
                "id": "",
                "nodes": [],
                "textData": {
                  "text": "Union Terminal is a Staffed station with NO Amtrak Ticketing Kiosks and NO checked baggage storage. (Baggage assistance provided by Amtrak Staff)",
