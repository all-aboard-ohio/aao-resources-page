            "nodes": [
              {
                "type": "TEXT",
                "id": "",
                "nodes": [],
                "textData": {
                  "text": "At All Aboard Ohio, we believe that passenger rail is more than just a mode of transportation—it's the key to building a more connected, thriving, and sustainable future for our state. With the release of our executive summary, ",
                  "decorations": [
                    {
                      "type": "COLOR"
                    }
                  ]
                }
              },
              {
                "type": "TEXT",
                "id": "",
                "nodes": [],
                "textData": {
                  "text": "Ohio Runs on Rail: Intercity Passenger Rail to Connect Our State",
                  "decorations": [
                    {
                      "type": "COLOR"
                    },
                    {
                      "type": "ITALIC"
                    }
                  ]
                }
              },
              {
                "type": "TEXT",
                "id": "",
                "nodes": [],
                "textData": {
                  "text": ", we are excited to share our vision and call to action for revitalizing Ohio’s rail network.",
                  "decorations": [
                    {
                      "type": "COLOR"
                    }
                  ]
                }
              }
            ],
            "paragraphData": {
              "textStyle": {
                "textAlignment": "AUTO"
              }
